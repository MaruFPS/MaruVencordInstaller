{
    "name": "maru-vencord-installer",
    "version": "0.2.3",
    "description": "One-click installer for Maru Vencord plugins.",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "pack:win": "electron-builder --win --x64 --dir",
        "dist:win": "electron-builder --win --x64"
    },
    "author": "Maru",
    "license": "ISC",
    "type": "module",
    "devDependencies": {
        "electron": "^43.4.1",
        "electron-builder": "26.15.3"
    },
    "build": {
        "appId": "com.maru.vencordinstaller",
        "productName": "Maru Vencord Installer",
        "asar": true,
        "directories": {
            "output": "release"
        },
        "files": [
            "main.js",
            "preload.cjs",
            "index.html",
            "package.json",
            "resource-policy.mjs",
            "bundle-policy.json"
        ],
        "extraResources": [
            {
                "from": "bundled-plugins",
                "to": "bundled-plugins",
                "filter": [
                    "twitchPresence.desktop/index.tsx",
                    "twitchPresence.desktop/native.ts",
                    "twitchPresence.desktop/TwitchPanel.tsx",
                    "kickPresence.desktop/index.tsx",
                    "kickPresence.desktop/native.ts",
                    "kickPresence.desktop/KickPanel.tsx",
                    "ytmDesktopControls.desktop/index.tsx",
                    "ytmDesktopControls.desktop/native.ts",
                    "ytmDesktopControls.desktop/PlayerComponent.tsx",
                    "statusSwitcher/index.tsx",
                    "statusSwitcher/style.css",
                    "maruWPEBackground/index.ts",
                    "maruWPEBackground/native.ts",
                    "maruFriendsSidebar/index.ts"
                ]
            },
            {
                "from": "MaruTwitchPresence",
                "to": "MaruTwitchPresence",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "source-overrides",
                "to": "source-overrides",
                "filter": [
                    "src/components/settings/tabs/themes/LocalThemesTab.tsx",
                    "src/components/settings/tabs/vencord/index.tsx"
                ]
            },
            {
                "from": "MaruKickPresence",
                "to": "MaruKickPresence",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "bundled-themes",
                "to": "bundled-themes",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "icon": "maru-vencord-installer.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowElevation": true,
            "perMachine": false,
            "allowToChangeInstallationDirectory": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "installerIcon": "maru-vencord-installer.ico",
            "uninstallerIcon": "maru-vencord-installer.ico"
        }
    }
}
